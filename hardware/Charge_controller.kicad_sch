	(text "Max I_ripple\n20% = 1.286A\n30% = 1.929A\n40% = 2.572A\nDesigned around 30% ripple"
		(exclude_from_sim no)
		(at 116.078 19.812 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4522bd87-b50c-4c70-a7aa-1757eb10e3a3")
	)
	(text "MOSFET selection math\nVds > 29.4/0.7 = 42V\n70% derate for Mosfets\n\nIrms *3 min margin for selection *6 margin for max selection\n6.431 * 3 = 19.293A lower limit\n6.431 * 6 = 38.59A upper limit\n\n98% effiency Max power 154.35\nCan lose 3.087W across all components\nallowing 20% conductance loss\n0.617W = 6.431^2 * Rds\nRds = 14.9 mOhm / 2 = 7.5 m Ohm / 2 = 3.7 mOhm\n(only 2 will be on at a time mainly and /2 for heating loss)"
		(exclude_from_sim no)
		(at 113.538 114.046 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a127e753-8be0-4744-9210-15fb9774987c")
	)
	(text "temp sensor\n"
		(exclude_from_sim no)
		(at 196.088 132.588 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fe846f7f-f593-465c-81c6-1ced5a27b2c4")
	)
	(text_box "Max Current Buck					\nP = VI			 						\n  = 29.4 * 5.25\n  = 154.4W	    \n\n154.4W = 24 * I\nI = 6.431A"
